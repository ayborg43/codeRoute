# Copy to .env for local runs, or paste these into Dokploy's Environment tab.
# Everything except ENCRYPTION_KEY and one provider key has a working default.

# --- Required ---------------------------------------------------------------

# AES key for provider keys at rest. MUST be exactly 16, 24, or 32 bytes.
# Generate one: openssl rand -base64 24
ENCRYPTION_KEY=change-me-in-production-32bytes!

# At least one provider key. These are encrypted into Postgres on startup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# The first operator account. Read only when no account exists, so re-running
# with these set will not reset a password you have since changed. Remove them
# from the environment once the account is created.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# A shared token for scripts and curl. People sign in with the email and
# password above; this exists so automation does not have to hold a session.
# Leave empty to disable it. Generate one: openssl rand -hex 32
ADMIN_TOKEN=

# Believe X-Forwarded-For and X-Forwarded-Proto. Only enable this behind a
# proxy that actually sets them — they are trivially forged otherwise, which
# would let an attacker dodge the sign-in lockout and make session cookies
# look secure when they are not.
TRUST_PROXY_HEADERS=false

# --- Deployment -------------------------------------------------------------

# Public hostname, used by the Traefik labels in docker-compose.dokploy.yml.
DOMAIN=coderouter.example.com

# Postgres password for the bundled database service.
POSTGRES_PASSWORD=change-me

# --- Routing ----------------------------------------------------------------

# auto   = smart routing only when the client asks for the "auto" model
# always = smart routing overrides whatever model the client asked for
# off    = always honour the client's model, use the static fallback chain
ROUTING_MODE=auto

# balanced | latency | cost
ROUTING_OBJECTIVE=balanced

DEFAULT_MODEL=gpt-4o-mini

# --- Semantic cache ---------------------------------------------------------

# Serves a stored completion for a near-identical prompt instead of paying a
# provider again. Needs pgvector and an OpenAI-compatible key for embeddings;
# without either it stays off and every request goes upstream as usual.
CACHE_ENABLED=true

# Minimum cosine similarity, 0..1, for a stored entry to answer a new prompt.
# 0.95 is close paraphrase. Lower it and the cache starts answering questions
# that were not asked.
CACHE_THRESHOLD=0.95

# How long a cached completion may be served.
CACHE_TTL=24h

# Requests above this temperature are never cached or served from cache: the
# caller asked for varied output. An unset temperature counts as cacheable.
CACHE_MAX_TEMPERATURE=0.3

# Embeddings default to text-embedding-3-small on the OpenAI endpoint. Point
# these at a local OpenAI-compatible server to keep prompts off the network.
# Any model used must return 1536 dimensions, matching the stored column.
EMBEDDING_MODEL=
EMBEDDING_BASE_URL=

# --- Providers --------------------------------------------------------------

# The gateway ships presets for OpenAI, Anthropic, Google Gemini, OpenRouter,
# Groq, SambaNova, Mistral, NVIDIA NIM, Hugging Face, GMI Cloud, xAI, DeepSeek,
# Together, Cerebras, xKiro, TeamoRouter and B.AI. All are offered in the
# dashboard; paste a key to enable one. Leave PROVIDERS empty for all of them.
#
#   PROVIDERS=groq,openrouter              only these two
#   PROVIDERS=+local=http://host:8000/v1   the presets plus a custom one
#
# A name=url pair defines any OpenAI-compatible provider, which is what most
# new vendors need — no rebuild.
PROVIDERS=

# Refuse to route to any model whose price is non-zero or unpublished. This is
# only the starting value: the dashboard has a button for it, and once used the
# stored setting wins over this. Callers can also ask per request by using the
# model name "auto:free".
FREE_ONLY=false

# How often each provider is asked what models it serves. Set 24h for a daily
# sync. Each refresh reports models added and withdrawn. 0 discovers once at
# startup and never again.
DISCOVERY_INTERVAL=1h

# --- Model catalogue --------------------------------------------------------

# Routing ranks over a catalogue of models with their prices and latencies.
# Override or extend the built-in list without rebuilding, either inline or
# from a file. Entries are merged by model name; add "replace": true to discard
# the built-ins entirely. Prices are USD per million tokens.
#
# MODEL_CATALOG={"models":[{"model":"gpt-4o-mini","provider":"openai","latency_ms":800,"input_cost_per_1m":0.15,"output_cost_per_1m":0.60,"tasks":["conversation","code_generation"]}]}
MODEL_CATALOG=
MODEL_CATALOG_PATH=

# How many of a provider's models one request may try before moving to the next
# provider, and the hard cap on upstream calls for a single request. A
# provider's list routinely contains models a given account cannot use, so one
# attempt each makes the first request likelier to fail than it needs to be.
ROUTING_ATTEMPTS_PER_PROVIDER=2
ROUTING_MAX_ATTEMPTS=8

# How often observed behaviour — success rate and latency — is folded back into
# ranking, and how far back to look when judging a model. This is the whole of
# the gateway's learning: it can tell a model that works from one that does
# not, but it never sees whether an answer was any good.
LATENCY_FEEDBACK_INTERVAL=5m
OBSERVATION_WINDOW=6h

# --- IoT (optional) ---------------------------------------------------------

# Leave MQTT_BROKER empty to disable the MQTT bridge. The /v1/iot HTTP
# endpoints work either way.
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=coderouter/v1

# An OpenAI-compatible local model server, tried before the cloud providers.
IOT_EDGE_ENDPOINT=

# Client key used to attribute MQTT-originated usage.
IOT_API_KEY=

# --- Advanced ---------------------------------------------------------------

# Override upstream endpoints for proxies, Azure-style deployments, or
# local OpenAI-compatible servers.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
