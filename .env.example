# Copy to .env for local runs, or paste these into Dokploy's Environment tab.
# Everything except ENCRYPTION_KEY and one provider key has a working default.

# --- Required ---------------------------------------------------------------

# AES key for provider keys at rest. MUST be exactly 16, 24, or 32 bytes.
# Generate one: openssl rand -base64 24
ENCRYPTION_KEY=change-me-in-production-32bytes!

# At least one provider key. These are encrypted into Postgres on startup.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# --- Deployment -------------------------------------------------------------

# Public hostname, used by the Traefik labels in docker-compose.dokploy.yml.
DOMAIN=coderouter.example.com

# Postgres password for the bundled database service.
POSTGRES_PASSWORD=change-me

# --- Routing ----------------------------------------------------------------

# auto   = smart routing only when the client asks for the "auto" model
# always = smart routing overrides whatever model the client asked for
# off    = always honour the client's model, use the static fallback chain
ROUTING_MODE=auto

# balanced | latency | cost
ROUTING_OBJECTIVE=balanced

DEFAULT_MODEL=gpt-4o-mini

# --- IoT (optional) ---------------------------------------------------------

# Leave MQTT_BROKER empty to disable the MQTT bridge. The /v1/iot HTTP
# endpoints work either way.
MQTT_BROKER=
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_PREFIX=coderouter/v1

# An OpenAI-compatible local model server, tried before the cloud providers.
IOT_EDGE_ENDPOINT=

# Client key used to attribute MQTT-originated usage.
IOT_API_KEY=

# --- Advanced ---------------------------------------------------------------

# Override upstream endpoints for proxies, Azure-style deployments, or
# local OpenAI-compatible servers.
OPENAI_BASE_URL=
ANTHROPIC_BASE_URL=
GOOGLE_BASE_URL=
